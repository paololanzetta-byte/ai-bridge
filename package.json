{
  "name": "ai-bridge",
  "version": "0.0.1",
  "private": true,
  "description": "Chat room a tre: utente, Claude e ChatGPT. Prototipo con adattatori finti.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "demo": "npm run build && node scripts/build-demo.mjs",
    "check:claude": "npm run build && node dist/apps/server/src/check-claude.js",
    "login:chatgpt": "npm run build && node dist/apps/server/src/login-chatgpt.js",
    "check:chatgpt": "npm run build && node dist/apps/server/src/check-chatgpt.js",
    "chat": "npm run build --silent && node dist/apps/server/src/chat.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
